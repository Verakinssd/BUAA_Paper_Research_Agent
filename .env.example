# Absolute path to a user-supplied Qwen3.8-27B Q4_K_M GGUF file.
# Model weights are not downloaded automatically.
GGUF_MODEL_PATH=
LLAMA_SERVER_BIN=llama-server
LLM_BACKEND=llamacpp
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=
LLM_MODEL=qwen-local
LLM_ALLOW_NO_KEY=1
# Do not route the localhost model service through environment proxies.
LLM_TRUST_ENV=0
LLM_ENABLE_THINKING=0
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.8
LLM_TOP_K=20
LLM_TOKENIZE=1
LLM_CONTEXT_TOKENS=8192
# A high-memory GPU can try 2; use 1 if VRAM is insufficient.
LLAMA_PARALLEL=1
SUMMARY_CHUNK_CHARS=24000
SUMMARY_NOTE_MAX_TOKENS=384
SUMMARY_FINAL_MAX_TOKENS=1024
REPORT_MAX_TOKENS=1536
# legacy directly extracts page text and avoids ONNX; use onnx only for complex layouts.
PDF_LAYOUT_MODE=legacy
PAPER_CACHE_DIR=outputs/_cache/fulltext
# Set to 1 to let paper APIs and PDF downloads inherit environment proxies.
PAPER_TRUST_ENV=0
# Metadata APIs: fail fast on 429 unless Retry-After is at most this many seconds.
PAPER_SOURCE_TIMEOUT=20
SOURCE_RETRY_AFTER_CAP=2
SOURCE_RETRY_BASE_SECONDS=1
# Optional explicit HTTP or SOCKS proxy reachable FROM the compute node.
# Example after an SSH reverse tunnel: http://127.0.0.1:17890
PAPER_PROXY_URL=
# Optional free OpenAlex key; small anonymous queries are supported currently.
OPENALEX_API_KEY=

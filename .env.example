# Personal network APIs can be configured after login in the web profile.
# No local model service is required in that mode. For a GPU-free setup use
# PAPER_RANKING_METHOD=bm25 instead of hybrid_rrf below.
# Absolute path to a user-supplied Qwen3.8-27B Q4_K_M GGUF file.
# Model weights are not downloaded automatically.
GGUF_MODEL_PATH=
# Optional model paths; defaults are models/Qwen3.8-27B-Q4_K_M.gguf and Q5_K_M.gguf.
GGUF_Q4_MODEL_PATH=
GGUF_Q5_MODEL_PATH=
# --managed exposes model switching here, independently of the inference API.
MODEL_CONTROL_URL=http://127.0.0.1:8001
LLAMA_SERVER_BIN=llama-server
LLM_BACKEND=llamacpp
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=
LLM_MODEL=qwen-local
LLM_ALLOW_NO_KEY=1
# Do not route the localhost model service through environment proxies.
LLM_TRUST_ENV=0
LLM_ENABLE_THINKING=0
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.8
LLM_TOP_K=20
LLM_TOKENIZE=1
LLM_CONTEXT_TOKENS=8192
# A high-memory GPU can try 2; use 1 if VRAM is insufficient.
LLAMA_PARALLEL=1
# Q5 starts with one slot to leave more VRAM available. GPU layers can be lowered if needed.
LLAMA_Q5_PARALLEL=1
LLAMA_Q5_GPU_LAYERS=99
SUMMARY_CHUNK_CHARS=24000
SUMMARY_NOTE_MAX_TOKENS=384
SUMMARY_FINAL_MAX_TOKENS=1024
REPORT_MAX_TOKENS=1536
# legacy directly extracts page text and avoids ONNX; use onnx only for complex layouts.
PDF_LAYOUT_MODE=legacy
PAPER_CACHE_DIR=outputs/_cache/fulltext
# Set to 1 to let paper APIs and PDF downloads inherit environment proxies.
PAPER_TRUST_ENV=0
# Metadata APIs: fail fast on 429 unless Retry-After is at most this many seconds.
PAPER_SOURCE_TIMEOUT=20
SOURCE_RETRY_AFTER_CAP=2
SOURCE_RETRY_BASE_SECONDS=1
# Optional explicit HTTP or SOCKS proxy reachable FROM the compute node.
# Example after an SSH reverse tunnel: http://127.0.0.1:17890
PAPER_PROXY_URL=
# Optional free OpenAlex key; small anonymous queries are supported currently.
OPENALEX_API_KEY=
# Accounts and avatars; defaults to this project's data/ (never commit it).
PAPER_DATA_DIR=
# Set to 1 only when the browser accesses this app through HTTPS.
PAPER_COOKIE_SECURE=0
# 相关性排序方法: basic (默认，原方法) | bm25 | dense_linear | hybrid_rrf.
PAPER_RANKING_METHOD=hybrid_rrf
# 向量排序模型后端服务地址，dense_linear 和 hybrid_rrf 方法需要指定。如果未指定，默认使用 bm25 方法，日志会有WARNING提示。
# FastAPI 服务由 deploy/serve_bge.py 启动
BGE_M3_SERVICE_URL=http://127.0.0.1:8002
BGE_M3_SERVICE_TIMEOUT=30
# Cross-Encoder 二阶段精排: none（默认）| local | http。
# 默认关闭，启用前请先完成候选集评测；失败时回退到第一阶段排序。
PAPER_RERANKING_METHOD=none
RERANKER_TOP_N=16
RERANKER_AGENT_TOP_M=8
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_SERVICE_URL=http://127.0.0.1:8003
RERANKER_TIMEOUT=30
RERANKER_TRUST_ENV=0
RERANKER_API_KEY=
RERANKER_FALLBACK=1
# 日志等级: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
